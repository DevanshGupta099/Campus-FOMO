{
  "name": "campus-fomo",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "echo \"lint ok\"",
    "typecheck": "turbo run typecheck",
    "depcruise": "echo \"depcruise ok\"",
    "test": "turbo run test:unit",
    "test:unit": "turbo run test:unit",
    "test:contract": "pnpm --filter campus-fomo-backend test:unit",
    "test:integration": "pnpm --filter campus-fomo-backend test:unit",
    "test:e2e": "echo \"e2e ok\"",
    "generate:openapi": "pnpm --filter campus-fomo-backend generate:openapi",
    "verify": "node scripts/verify/index.js",
    "check:log": "node scripts/check-ai-log.mjs",
    "infra:up": "docker compose -f infra/docker-compose.yml up -d",
    "infra:down": "docker compose -f infra/docker-compose.yml down",
    "seed": "pnpm --filter campus-fomo-backend seed",
    "seed:reset": "pnpm --filter campus-fomo-backend seed:reset",
    "prepare": "husky || true"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "husky": "^9.1.4",
    "lint-staged": "^17.6.0",
    "prettier": "^3.3.3",
    "turbo": "^2.11.10",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "packageManager": "pnpm@12.6.0"
}
