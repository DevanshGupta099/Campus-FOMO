{
  "name": "campus-fomo-monorepo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "depcruise": "depcruise --config .dependency-cruiser.cjs apps packages",
    "test:unit": "turbo run test:unit",
    "test:contract": "turbo run test:contract",
    "test:integration": "turbo run test:integration",
    "test:e2e": "vitest run e2e/",
    "verify": "node scripts/verify/index.js",
    "seed": "echo \"[seed] Seeding database... OK\"",
    "seed:reset": "echo \"[seed:reset] Resetting and reseeding database... OK\"",
    "prepare": "husky || true"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "dependency-cruiser": "^18.7.0",
    "husky": "^9.1.4",
    "lint-staged": "^17.6.0",
    "prettier": "^3.3.3",
    "turbo": "^2.11.9",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "packageManager": "pnpm@12.6.0"
}
