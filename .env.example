# Environment configuration for Campus FOMO
# Node runtime
NODE_ENV=development
PORT=3001
HOST=0.0.0.0

# Database (PostgreSQL 16)
DATABASE_URL=postgres://fomo_user:fomo_secret@localhost:5432/campus_fomo
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10

# Redis Cache & PubSub (Redis 7)
REDIS_URL=redis://localhost:6379

# Cryptography & Security Secrets
JWT_ACCESS_SECRET=dev_jwt_access_secret_must_be_at_least_32_characters_long!
JWT_REFRESH_SECRET=dev_jwt_refresh_secret_must_be_at_least_32_characters_long!
COOKIE_SECRET=dev_cookie_signing_secret_key_at_least_32_bytes_long!
OTP_HMAC_SECRET=dev_otp_hmac_secret_key_for_hash_storage_32chars!

# CORS & Application URLs
APP_ORIGIN=http://localhost:5173
API_BASE_URL=http://localhost:3001/api/v1

# Frontend Vite variables
VITE_API_MODE=mock
VITE_API_BASE_URL=http://localhost:3001/api/v1

# Providers (ports & adapters)
SMS_PROVIDER=dev
EMAIL_PROVIDER=mailpit

# Mailpit (Dev Email)
MAILPIT_SMTP_HOST=localhost
MAILPIT_SMTP_PORT=1025
MAILPIT_WEB_PORT=8025

# Optional Third-Party Keys (production only)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SERVICE_SID=
MSG91_AUTH_KEY=
MSG91_SENDER_ID=
MSG91_DLT_TE_ID=
CLOUDFLARE_TURNSTILE_SECRET_KEY=
VITE_TURNSTILE_SITE_KEY=
GEMINI_API_KEY=
