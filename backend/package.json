{
  "name": "campus-fomo-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/server.js",
  "types": "./dist/server.d.ts",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "generate:openapi": "tsx scripts/generate-openapi.ts",
    "access:sync": "tsx scripts/access-sync.ts",
    "seed": "tsx src/seed/index.ts",
    "seed:reset": "tsx src/seed/index.ts --reset",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:integration": "vitest run"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.1",
    "@fastify/helmet": "^13.2.0",
    "@fastify/rate-limit": "^11.2.1",
    "dotenv": "^18.0.9",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.12.7",
    "fastify-plugin": "^6.0.1",
    "ioredis": "^6.0.0",
    "jose": "^6.2.14",
    "postgres": "^4.0.0",
    "yaml": "^2.4.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.16.5",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
